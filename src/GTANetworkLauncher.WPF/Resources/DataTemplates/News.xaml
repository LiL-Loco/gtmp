<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:newsapi="clr-namespace:GrandTheftMultiplayer.Launcher.Models.News"
    xmlns:converters="clr-namespace:GrandTheftMultiplayer.Launcher.Converters">
    <DataTemplate x:Key="NewsDataTemplate" DataType="{x:Type newsapi:NewsDisplayModel}">
        <DataTemplate.Resources>
            <converters:HtmlPanelDisplayConverter x:Key="HtmlPanelDisplayConverter" />
        </DataTemplate.Resources>
        
        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--<controls:ProgressRing x:Name="ImageLoadProgressRing" Grid.Row="0" />-->

            <Grid Grid.Row="0">

                <!--
                    Was a semi-transparent black scrim over the news image,
                    assuming a light panel underneath. On the dark theme it is
                    an invisible tint, so it reads as SurfaceRaised instead.
                -->
                <Grid VerticalAlignment="Bottom" Background="{DynamicResource SurfaceRaisedBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="{Binding ForumPostItem.Title}"
                        FontFamily="{StaticResource UiFontSemibold}"
                        FontSize="18"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Margin="12,10"
                        TextTrimming="CharacterEllipsis"
                        Grid.Column="0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock
                            FontFamily="{StaticResource UiFont}"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                            <Run Text="By:" />
                            <Run Text="{Binding ForumPostItem.Author}" />
                            <Run Text="on"/>
                            <Run Text="{Binding ForumPostItem.Timestamp, StringFormat=dd/MM/yyyy HH:mm}" />
                        </TextBlock>

                        <!--
                          The default MahApps button rendered white-on-light here:
                          its accent fill came from the light theme, so it stayed a
                          white block against the dark news panel. Explicit accent
                          fill, matching the LAUNCH button in the header.
                        -->
                        <Button Command="{Binding ToggleReadMoreCommand}"
                                Background="{DynamicResource AccentInteractiveBrush}"
                                BorderThickness="0"
                                Foreground="{DynamicResource IdealForegroundColorBrush}"
                                Padding="12,6"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentInteractiveHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Margin="0,0,10,0"
                                           Text="Read more"
                                           Foreground="{DynamicResource IdealForegroundColorBrush}" />

                                <Rectangle Width="14"
                                           Height="14"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource IdealForegroundColorBrush}"
                                           Grid.Column="1">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource appbar_chevron_right}" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>

            <!-- Explicit surface brush. This used to read SystemColors.MenuBrushKey, which
                 is white on a light system and is only dark on this theme because
                 ModernDark.xaml overrides that system key. Naming the surface
                 directly makes the panel independent of the system palette. -->
            <Grid Background="{DynamicResource AppBackgroundBrush}" Grid.Row="1">
                <ContentPresenter>
                    <ContentPresenter.Content>
                        <MultiBinding Converter="{StaticResource HtmlPanelDisplayConverter}">
                            <Binding Path="ReadMoreExpanded" />
                            <Binding Path="ForumPostItem.Text" />
                        </MultiBinding>
                    </ContentPresenter.Content>
                </ContentPresenter>
                <!--<wpf:HtmlPanel Visibility="{Binding ReadMoreExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ForumPostItem.Text}" FontSize="14" Margin="5" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />-->
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>